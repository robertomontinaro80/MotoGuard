#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🏍️  MotoGuard pre-commit checks..."

# 1. Lint + format staged files
npx lint-staged

# 2. Type check
echo "→ Type checking..."
npx tsc --noEmit
if [ $? -ne 0 ]; then
  echo "❌ TypeScript errors found. Fix them before committing."
  exit 1
fi

# 3. Run tests related to changed files
echo "→ Running tests..."
npx jest --passWithNoTests --findRelatedTests $(git diff --cached --name-only | tr '\n' ' ')
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Fix them before committing."
  exit 1
fi

echo "✅ All checks passed!"
